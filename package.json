{
  "name": "react-native-storage-toolkit",
  "version": "2.0.0",
  "description": "Typed, validated and migratable key-value storage for React Native and Expo, on top of MMKV, AsyncStorage, SecureStore or localStorage.",
  "license": "MIT",
  "author": "Muhittin Camdali",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muhittincamdali/ReactNativeStorage.git"
  },
  "homepage": "https://github.com/muhittincamdali/ReactNativeStorage#readme",
  "bugs": {
    "url": "https://github.com/muhittincamdali/ReactNativeStorage/issues"
  },
  "keywords": [
    "react-native",
    "expo",
    "storage",
    "mmkv",
    "async-storage",
    "secure-store",
    "typescript",
    "standard-schema",
    "react-hooks"
  ],
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.lib.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "docs": "typedoc",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "valibot": "^1.5.0",
    "vitest": "^5.0.5",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  }
}
